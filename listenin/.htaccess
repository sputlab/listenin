# ListenIn — pubblicato in /htdocs/webapp/listenin/ (URL: /webapp/listenin/)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Adeguare se l'applicazione viene spostata in un altro percorso
  RewriteBase /webapp/listenin/
  # Forza HTTPS (anche dietro proxy che impostano X-Forwarded-Proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # URL parlanti delle ricerche: /webapp/listenin/frequenze/lombardia/milano/dmr (stessa applicazione, percorso letto dal browser)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^frequenze(/.*)?$ index.php [L]
  # URL "puliti" dell'API per client esterni: /webapp/listenin/api/frequencies
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.+)$ api/index.php?route=/$1 [QSA,L]
  # Cartella privata: 404 anche se .htaccess interni non venissero letti
  RewriteRule ^app(/|$) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Script e fogli di stile: il browser li ricontrolla a ogni visita (risposta 304 se non cambiati),
  # così un aggiornamento dei file si vede subito senza svuotare la cache.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.svg$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddCharset utf-8 .css .js .svg
</IfModule>

# Nessun file nascosto, di backup o di servizio
<FilesMatch "(^\.|\.(bak|sql|log|ini|sh|md|json)$|^app-path\.php$)">
  Require all denied
</FilesMatch>
